{
  "name": "dsh-study-tree",
  "version": "0.7.1",
  "description": "DeepSeek Harness 树形学习工作台",
  "private": true,
  "type": "module",
  "engines": {
    "dsh": "0.2.2-rc.3"
  },
  "exports": {
    ".": "./dist/host.js",
    "./client": "./dist/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "dist",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-user-questions",
        "@deepseek-ai/dsh-client-ui-approval",
        "@deepseek-ai/dsh-client-ui-context-menu",
        "@deepseek-ai/dsh-client-ui-session"
      ]
    }
  },
  "scripts": {
    "prepack": "npm run build",
    "build": "node scripts/build.mjs",
    "test": "node --test"
  },
  "devDependencies": {
    "@dagrejs/dagre": "^1.1.5",
    "@deepseek-ai/dsh-util-workspace-path": "0.2.2-rc.3",
    "@xyflow/react": "^12.8.0",
    "esbuild": "^0.25.0",
    "katex": "^0.16.47",
    "lucide-react": "^0.468.0",
    "playwright-core": "1.65.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "zod": "^4.6.7"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sunmingqi-1/dsh-tree.git"
  },
  "homepage": "https://github.com/sunmingqi-1/dsh-tree#readme",
  "bugs": {
    "url": "https://github.com/sunmingqi-1/dsh-tree/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "learning",
    "infinite-canvas",
    "conversation-tree"
  ]
}
