{
  "name": "dsh-study-tree",
  "version": "0.9.0-rc.1",
  "description": "DeepSeek Harness 树形学习工作台",
  "private": true,
  "type": "module",
  "engines": {
    "dsh": "0.2.2-rc.5"
  },
  "exports": {
    ".": "./dist/host.js",
    "./client": "./dist/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./session-store": "./dist/runtime/session-store.js",
    "./persistence-jsonl": "./dist/runtime/persistence-jsonl.js",
    "./session-projection": "./dist/runtime/session-projection.js",
    "./session-query": "./dist/runtime/session-query.js",
    "./token-meter": "./dist/runtime/token-meter.js",
    "./goal-round-driver": "./dist/runtime/goal-round-driver.js",
    "./jobs-local": "./dist/runtime/jobs-local.js",
    "./subagent": "./dist/runtime/subagent.js",
    "./subagent-fork-in-process": "./dist/runtime/subagent-fork-in-process.js",
    "./agent-loop": "./dist/runtime/agent-loop.js",
    "./tool-jobs": "./dist/runtime/tool-jobs.js",
    "./branch-routing": "./dist/runtime/branch-routing.js",
    "./branch-history": "./dist/runtime/branch-history.js",
    "./preset-registry": "./dist/runtime/preset-registry.js"
  },
  "files": [
    "dist",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "runtime/NOTICE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-user-questions",
        "@deepseek-ai/dsh-client-ui-approval",
        "@deepseek-ai/dsh-client-ui-context-menu",
        "@deepseek-ai/dsh-client-ui-session"
      ]
    }
  },
  "scripts": {
    "prepack": "npm run build",
    "build": "node scripts/build.mjs",
    "test": "node --test"
  },
  "devDependencies": {
    "@dagrejs/dagre": "^1.1.5",
    "@deepseek-ai/dsh-agent-loop": "0.2.2-rc.5",
    "@deepseek-ai/dsh-goal-round-driver": "0.2.2-rc.5",
    "@deepseek-ai/dsh-jobs-local": "0.2.2-rc.5",
    "@deepseek-ai/dsh-session": "0.2.2-rc.5",
    "@deepseek-ai/dsh-session-persistence-jsonl": "0.2.2-rc.5",
    "@deepseek-ai/dsh-session-projection": "0.2.2-rc.5",
    "@deepseek-ai/dsh-session-query-sqlite": "0.2.2-rc.5",
    "@deepseek-ai/dsh-subagent": "0.2.2-rc.5",
    "@deepseek-ai/dsh-subagent-fork-in-process": "0.2.2-rc.5",
    "@deepseek-ai/dsh-token-meter": "0.2.2-rc.5",
    "@deepseek-ai/dsh-tool-jobs": "0.2.2-rc.5",
    "@deepseek-ai/dsh-util-workspace-path": "0.2.2-rc.5",
    "@xyflow/react": "^12.8.0",
    "diff": "8.0.4",
    "esbuild": "^0.25.0",
    "katex": "^0.16.47",
    "lucide-react": "^0.468.0",
    "playwright-core": "1.65.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "zod": "^4.6.7"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sunmingqi-1/dsh-tree.git"
  },
  "homepage": "https://github.com/sunmingqi-1/dsh-tree#readme",
  "bugs": {
    "url": "https://github.com/sunmingqi-1/dsh-tree/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "learning",
    "infinite-canvas",
    "conversation-tree"
