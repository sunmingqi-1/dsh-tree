+/** Fold the original entries of one branch in their model-history order. */
+function foldHistory(
+  def: ErasedDefinition,
+  events: readonly SessionEvent[],
+  header: SessionHeader,
+  inherited: SessionLogOffset,
+): unknown {
+  let state = def.init(header, inherited)
+  for (const event of events) state = def.apply(state, event)
+  return state
+}
+
+/** Refresh only context projections when a live turn changes its ancestry. */
+function foldLiveEvent(def: ErasedDefinition, state: unknown, event: SessionEvent, session: Session): unknown {
+  if (def.history === 'active-path' && session.pathSwitchedAt?.(event.seq)) {
+    return foldHistory(def, session.activePathEvents(event.seq), session.header, session.inheritedEventCount)
+  }
+  return def.apply(state, event)
+}
+
+/**
+ * Find the latest possible change of ancestry in a stored slice. A normal child of
+ * the latest completed turn can always reuse the checkpoint. A suffix may omit
+ * the earlier boundary, in which case only the live index can prove continuity.
+ */
+function lastAncestryChange(events: readonly SessionEvent[], session?: Session): SessionSeq | undefined {
+  if (session !== undefined) {
+    if (!session.pathGeneration) return
+    return events.findLast(event => session.pathSwitchedAt?.(event.seq))?.seq
+  }
+  let lastEnd: SessionSeq | undefined
+  let change: SessionSeq | undefined
+  for (const event of events) {
+    if (event.type === 'turn/end') lastEnd = event.seq
+    if (event.type === 'turn/start' && typeof event.data.parentSeq === 'number' && event.data.parentSeq !== lastEnd) {
+      change = event.seq
+    }
+  }
+  return change
 }
 
